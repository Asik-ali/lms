{
  "rewrites": [
    {
      "source": "/((?!api/|browser-block\\.html$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^(?!.*EXAMSTICK_APP).*$"
        }
      ],
      "destination": "/browser-block.html"
    },
    {
      "source": "/api/save-subscription",
      "destination": "/api/send-push?operation=save-subscription"
    },
    {
      "source": "/api/vapid-public-key",
      "destination": "/api/send-push?operation=vapid-public-key"
    },
    {
      "source": "/((?!api/|assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|assets/|.*\\.[^/]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
