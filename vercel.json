{
  "routes": [
    {
      "src": "^/r/([A-Za-z0-9_-]{1,32})/?$",
      "dest": "/r.html?code=$1"
    },
    {
      "src": "^/((?!api/|browser-block\\.html$|r\\.html$).*)$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*EXAMSTICK_APP.*"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*; wv.*"
        }
      ],
      "dest": "/browser-block.html"
    },
    {
      "src": "^/api/save-subscription$",
      "dest": "/api/send-push?operation=save-subscription"
    },
    {
      "src": "^/api/vapid-public-key$",
      "dest": "/api/send-push?operation=vapid-public-key"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/((?!api/|assets/|.*\\.[^/]+$).*)$",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|assets/|.*\\.[^/]+$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
